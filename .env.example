# ─────────────────────────────────────────────
# LexAI CR — Environment Variables
# Copy this file to .env and fill in the values
# ─────────────────────────────────────────────

# PostgreSQL database connection
DATABASE_URL=postgresql://user:password@host:5432/lexai_cr

# Session secret — generate with: openssl rand -base64 32
SESSION_SECRET=your-session-secret-here

# OpenAI API key (for AI chat and document analysis)
OPENAI_API_KEY=sk-...

# Dropbox Sign API key (optional — enables real e-signature)
DROPBOX_SIGN_API_KEY=

# Google OAuth (optional — enables "Sign in with Google")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Production URL of the deployed app
APP_URL=https://lexai.cr

# Server port (default: 5000)
PORT=5000
